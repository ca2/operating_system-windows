file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(GLOB runtime_dlls "${INSTALL_DIR}/bin/libcrypto-3*.dll" "${INSTALL_DIR}/bin/libssl-3*.dll")
list(LENGTH runtime_dlls count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Expected exactly one OpenSSL crypto/SSL DLL pair in ${INSTALL_DIR}/bin")
endif()
foreach(dll IN LISTS runtime_dlls)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${dll}" "${OUTPUT_DIR}"
        COMMAND_ERROR_IS_FATAL ANY)
    if(XP AND DEPLOY_DIR)
        set(SOURCE_FILE "${dll}")
        set(DESTINATION "${DEPLOY_DIR}")
        include("${CMAKE_CURRENT_LIST_DIR}/../reactos-import-audit/deployment-copy.cmake")
    endif()
endforeach()
# The default provider is built into libcrypto. Keep optional provider modules
# available too; applications using them can set OPENSSL_MODULES to this folder.
if(EXISTS "${INSTALL_DIR}/lib/ossl-modules")
    file(COPY "${INSTALL_DIR}/lib/ossl-modules/" DESTINATION "${OUTPUT_DIR}/ossl-modules")
    if(XP AND DEPLOY_DIR)
        file(GLOB modules "${INSTALL_DIR}/lib/ossl-modules/*.dll")
        foreach(dll IN LISTS modules)
            set(SOURCE_FILE "${dll}")
            set(DESTINATION "${DEPLOY_DIR}/ossl-modules")
            include("${CMAKE_CURRENT_LIST_DIR}/../reactos-import-audit/deployment-copy.cmake")
        endforeach()
    endif()
endif()
