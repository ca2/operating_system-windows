<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <PlatformLower2>$([System.String]::Copy('$(Platform)').ToLower())</PlatformLower2>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateManifest>true</GenerateManifest>
    <EmbedManifest>true</EmbedManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile />
    <PreBuildEvent>
      <Command>application_build_helper --defer-prepare-folder $(ProjectDir) $(PlatformName) $(ConfigurationName)</Command>
    </PreBuildEvent>
    <Link>
      <ModuleDefinitionFile>
      </ModuleDefinitionFile>
    </Link>
    <Manifest>
      <AdditionalManifestFiles>$(MSBuildThisFileDirectory)windows10.manifest;$(MSBuildThisFileDirectory)tools\windows-common-controls\common-controls.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="PlatformLower2">
      <Value>$(PlatformLower)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>